{% extends 'layouts/auth.twig' %}

{% block title %}{{ t('auth.forgot_title') }} · {{ app_name }}{% endblock %}

{% block content %}
<h1 class="text-2xl font-semibold text-ink">{{ t('auth.forgot_title') }}</h1>
<p class="mt-1 text-sm text-muted">{{ t('auth.forgot_subtitle') }}</p>

{% if sent %}
  <div class="mt-6">
    {% include 'components/feedback/alert.twig' with { tone: 'success', message: message|default(t('auth.reset_sent')) } only %}
  </div>
{% endif %}

<form method="post" action="/forgot-password" class="mt-6 space-y-5" novalidate>
  {{ csrf_field() }}
  {% include 'components/forms/input.twig' with {
    name: 'email', label: t('auth.email'), type: 'email', value: email,
    autocomplete: 'email', inputmode: 'email', required: true,
  } only %}
  {% include 'components/buttons/button.twig' with { label: t('auth.send_reset'), type: 'submit', full_width: true } only %}
</form>

<p class="mt-8 text-sm text-muted">
  <a href="/login" class="font-medium text-primary-strong hover:underline">{{ t('auth.back_to_login') }}</a>
</p>
{% endblock %}
