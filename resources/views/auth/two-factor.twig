{% extends 'layouts/auth.twig' %}

{% block title %}{{ t('auth.two_factor_title') }} · {{ app_name }}{% endblock %}

{% block content %}
<h1 class="text-2xl font-semibold text-ink">{{ t('auth.two_factor_title') }}</h1>
<p class="mt-1 text-sm text-muted">{{ t('auth.two_factor_subtitle') }}</p>

{% if error %}
  <div class="mt-6">
    {% include 'components/feedback/alert.twig' with { tone: 'danger', message: error } only %}
  </div>
{% endif %}

<form method="post" action="/two-factor" class="mt-6 space-y-5" novalidate>
  {{ csrf_field() }}
  <input type="hidden" name="next" value="{{ next|default('/dashboard') }}">
  {% include 'components/forms/input.twig' with {
    name: 'code', label: t('auth.code'), inputmode: 'numeric',
    autocomplete: 'one-time-code', required: true, help: t('auth.code_help'),
  } only %}
  {% include 'components/buttons/button.twig' with { label: t('auth.verify_code'), type: 'submit', full_width: true } only %}
</form>

<form method="post" action="/logout" class="mt-8">
  {{ csrf_field() }}
  {% include 'components/buttons/button.twig' with { label: t('auth.sign_out'), type: 'submit', variant: 'ghost', full_width: true } only %}
</form>
{% endblock %}
