{% extends 'layouts/auth.twig' %}

{% block title %}{{ t('auth.reset_title') }} · {{ app_name }}{% endblock %}

{% block content %}
<h1 class="text-2xl font-semibold text-ink">{{ t('auth.reset_title') }}</h1>
<p class="mt-1 text-sm text-muted">{{ t('auth.reset_subtitle') }}</p>

{% if errors.token|default('') %}
  <div class="mt-6">
    {% include 'components/feedback/alert.twig' with { tone: 'danger', message: t('auth.invalid_reset') } only %}
  </div>
{% elseif errors|length > 0 %}
  <div class="mt-6">
    {% include 'components/feedback/alert.twig' with { tone: 'danger', title: t('forms.fix_errors_title'), message: t('forms.fix_errors_body', { count: errors|length }) } only %}
  </div>
{% endif %}

{% if token %}
  <form method="post" action="/reset-password/{{ token }}" class="mt-6 space-y-5" novalidate>
    {{ csrf_field() }}
    {% include 'components/forms/password.twig' with {
      name: 'password', label: t('auth.password'), autocomplete: 'new-password',
      required: true, help: t('auth.password_help'), error: errors.password|default(''),
    } only %}
    {% include 'components/forms/password.twig' with {
      name: 'password_confirmation', label: t('auth.confirm_password'),
      autocomplete: 'new-password', required: true,
    } only %}
    {% include 'components/buttons/button.twig' with { label: t('auth.update_password'), type: 'submit', full_width: true } only %}
  </form>
{% endif %}

<p class="mt-8 text-sm text-muted">
  <a href="/login" class="font-medium text-primary-strong hover:underline">{{ t('auth.back_to_login') }}</a>
</p>
{% endblock %}
