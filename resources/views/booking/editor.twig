{#
  Booking-page editor: publish banner, settings form, section toggles,
  FAQ manager and version history. Data hydrates via /api/booking-page.
#}
{% extends 'layouts/dashboard.twig' %}

{% set page_title = t('nav.booking_page') %}
{% set active_nav = 'booking_page' %}
{% set workspace = tenant.name %}

{% block title %}{{ t('nav.booking_page') }} · {{ app_name }}{% endblock %}

{% block content %}
<div data-page="booking-page"
     {% if membership.can('booking_page.manage') %} data-can-manage="1"{% endif %}
     {% if membership.can('booking_page.publish') %} data-can-publish="1"{% endif %}>
  <div class="mb-6 flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 class="text-2xl font-semibold text-ink">{{ t('booking_page.title') }}</h2>
      <p class="mt-1 text-sm text-muted">{{ t('booking_page.subtitle') }}</p>
      <a data-live-url href="#" target="_blank" rel="noopener" class="mt-2 hidden items-center gap-1.5 text-sm font-medium text-primary hover:underline">
        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
        <span data-live-url-text></span>
      </a>
    </div>
    {% if membership.can('booking_page.publish') %}
    <button type="button" class="btn btn-primary btn-md" data-publish>
      <i class="fa-solid fa-rocket" aria-hidden="true"></i>
      <span>{{ t('booking_page.publish') }}</span>
    </button>
    {% endif %}
  </div>

  <div class="grid gap-6 xl:grid-cols-2">
    <div class="card p-6">
      <h3 class="text-lg font-semibold text-ink">{{ t('booking_page.settings_heading') }}</h3>
      <p class="mt-1 text-sm text-muted">{{ t('booking_page.settings_subtitle') }}</p>
      <form data-editor-form class="mt-5 flex flex-col gap-4" novalidate></form>
    </div>

    <div class="flex flex-col gap-6">
      <div class="card p-6">
        <h3 class="text-lg font-semibold text-ink">{{ t('booking_page.sections_heading') }}</h3>
        <p class="mt-1 text-sm text-muted">{{ t('booking_page.sections_subtitle') }}</p>
        <div data-sections class="mt-5 space-y-2"></div>
      </div>

      <div class="card p-6">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h3 class="text-lg font-semibold text-ink">{{ t('booking_page.faqs_heading') }}</h3>
            <p class="mt-1 text-sm text-muted">{{ t('booking_page.faqs_subtitle') }}</p>
          </div>
          {% if membership.can('booking_page.manage') %}
          <button type="button" class="btn btn-primary btn-md shrink-0" data-faq-new>
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            <span>{{ t('booking_page.faq_new') }}</span>
          </button>
          {% endif %}
        </div>
        <div data-faqs class="mt-5 space-y-3"></div>
      </div>

      <div class="card p-6">
        <h3 class="text-lg font-semibold text-ink">{{ t('booking_page.versions_heading') }}</h3>
        <p class="mt-1 text-sm text-muted">{{ t('booking_page.versions_subtitle') }}</p>
        <div data-versions class="mt-5 space-y-2"></div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
