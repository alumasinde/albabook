{#
  Tenant portal shell (dashboard.md §1): sidebar on desktop, drawer on mobile.
  Navigation items are permission-aware from Phase 2; Phase 1 shows the structure.
#}
{% extends 'layouts/base.twig' %}

{% block body %}
{% include 'components/feedback/support-banner.twig' only %}
<div class="min-h-screen lg:flex">
  {% include 'components/layout/sidebar.twig' with {
    brand: app_name,
    workspace: workspace|default('Royal Beauty Studio'),
    active: active_nav|default('overview'),
    sections: [
      { title: t('nav.workspace'), items: [
        { key: 'overview', label: t('nav.overview'), icon: 'fa-gauge', href: '/' },
        { key: 'calendar', label: t('nav.calendar'), icon: 'fa-calendar-days', href: '#' },
        { key: 'appointments', label: t('nav.appointments'), icon: 'fa-clipboard-list', href: '#' },
        { key: 'services', label: t('nav.services'), icon: 'fa-scissors', href: '#' },
        { key: 'staff', label: t('nav.staff'), icon: 'fa-user-group', href: '#' },
        { key: 'customers', label: t('nav.customers'), icon: 'fa-address-book', href: '#' },
        { key: 'branches', label: t('nav.branches'), icon: 'fa-location-dot', href: '#' },
        { key: 'resources', label: t('nav.resources'), icon: 'fa-couch', href: '#' },
      ] },
      { title: t('nav.management'), items: [
        { key: 'reports', label: t('nav.reports'), icon: 'fa-chart-line', href: '#' },
        { key: 'notifications', label: t('nav.notifications'), icon: 'fa-bell', href: '#' },
        { key: 'booking_page', label: t('nav.booking_page'), icon: 'fa-globe', href: '#' },
        { key: 'team', label: t('nav.team'), icon: 'fa-user-shield', href: '/team' },
        { key: 'settings', label: t('nav.settings'), icon: 'fa-gear', href: '#' },
        { key: 'components', label: t('nav.components'), icon: 'fa-swatchbook', href: '/_system/components' },
      ] },
    ],
  } only %}

  <div class="flex min-w-0 flex-1 flex-col">
    {% include 'components/layout/header.twig' with { title: page_title|default(app_name) } only %}
    <main id="main" class="flex-1 px-4 py-6 sm:px-6 lg:px-8" tabindex="-1">
      {% block content %}{% endblock %}
    </main>
  </div>
</div>
{% endblock %}
