{#
  Base HTML document. Every shell extends this.
  No inline script or style: CSP allows only same-origin files (SecurityHeadersMiddleware).
#}
<!doctype html>
<html lang="{{ locale() }}" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="{{ csrf_token() }}">
  <meta name="robots" content="{% block robots %}noindex, nofollow{% endblock %}">
  <title>{% block title %}{{ app_name }}{% endblock %}</title>
  <link rel="icon" href="{{ asset('images/favicon.svg') }}" type="image/svg+xml">
  <link rel="stylesheet" href="{{ asset('vendor/fontawesome/css/all.min.css') }}">
  <link rel="stylesheet" href="{{ asset('css/app.css') }}">
  {% block head %}{% endblock %}
  <script src="{{ asset('js/app.js') }}" defer></script>
</head>
<body class="{% block body_class %}min-h-full bg-surface text-ink antialiased{% endblock %}">
  <a href="#main" class="skip-link">{{ t('common.skip_to_content') }}</a>
  {% block body %}{% endblock %}
  <div id="toast-region" class="toast-region" aria-live="polite" aria-atomic="false"></div>
</body>
</html>
