{#
  Base HTML document. Every shell extends this.
  No inline script or style: CSP allows only same-origin files (SecurityHeadersMiddleware).
  SPA fragment mode (X-SPA: fragment): emit only the content block plus a title
  marker; the client swaps it into the live document (spa.js).
#}
{% if spa|default(false) %}<template data-spa-title>{{ block('title') }}</template><template data-spa-heading>{{ page_title|default('') }}</template>{{ block('content') }}{% else %}<!doctype html>
<html lang="{{ locale() }}" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="{{ csrf_token() }}">
  <meta name="robots" content="{% block robots %}noindex, nofollow{% endblock %}">
  <title>{% block title %}{{ app_name }}{% endblock %}</title>
  <link rel="icon" href="{{ asset('images/favicon.svg') }}" type="image/svg+xml">
  <link rel="stylesheet" href="{{ asset('vendor/fontawesome/css/all.min.css') }}">
  <link rel="stylesheet" href="{{ asset('css/app.css') }}">
  {% block head %}{% endblock %}
  <script src="{{ asset('js/app.js') }}" defer></script>
  <script src="{{ asset('js/api.js') }}" defer></script>
  <script src="{{ asset('js/ui.js') }}" defer></script>
  <script src="{{ asset('js/spa.js') }}" defer></script>
  <script src="{{ asset('js/pages.js') }}" defer></script>
  {# Page bundles. The default is the dashboard superset; public and other
     lean shells set page_scripts to only what their pages need so the
     booking page stays light on slow connections (update.md 4.2/9.2). #}
  {% for src in page_scripts|default([
      'appointment-modal.js',
      'pages/dashboard.js', 'pages/appointments.js', 'pages/calendar.js',
      'pages/availability.js', 'pages/setup.js', 'pages/services.js',
      'pages/staff.js', 'pages/customers.js', 'pages/settings.js',
      'pages/branches.js', 'pages/resources.js', 'pages/booking-page.js',
      'pages/notifications.js', 'pages/reports.js', 'pages/integrations.js',
      'pages/billing.js', 'pages/till.js',
  ]) %}
  <script src="{{ asset('js/' ~ src) }}" defer></script>
  {% endfor %}
</head>
<body class="{% block body_class %}min-h-full bg-surface text-ink antialiased{% endblock %}">
  <a href="#main" class="skip-link">{{ t('common.skip_to_content') }}</a>
  {% block body %}{% endblock %}
  <div id="toast-region" class="toast-region" aria-live="polite" aria-atomic="false"></div>
</body>
</html>{% endif %}
