{#
  Base HTML document. Every shell extends this.
  No inline script or style: CSP allows only same-origin files (SecurityHeadersMiddleware).
  SPA fragment mode (X-SPA: fragment): emit only the content block plus a title
  marker; the client swaps it into the live document (spa.js).
#}
{% if spa|default(false) %}<template data-spa-title>{{ block('title') }}</template><template data-spa-heading>{{ page_title|default('') }}</template>{{ block('content') }}{% else %}<!doctype html>
<html lang="{{ locale() }}" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="{{ csrf_token() }}">
  <meta name="robots" content="{% block robots %}noindex, nofollow{% endblock %}">
  <title>{% block title %}{{ app_name }}{% endblock %}</title>
  <link rel="icon" href="{{ asset('images/favicon.svg') }}" type="image/svg+xml">
  <link rel="stylesheet" href="{{ asset('vendor/fontawesome/css/all.min.css') }}">
  <link rel="stylesheet" href="{{ asset('css/app.css') }}">
  {% block head %}{% endblock %}
  <script src="{{ asset('js/app.js') }}" defer></script>
  <script src="{{ asset('js/api.js') }}" defer></script>
  <script src="{{ asset('js/ui.js') }}" defer></script>
  <script src="{{ asset('js/spa.js') }}" defer></script>
  <script src="{{ asset('js/pages.js') }}" defer></script>
  <script src="{{ asset('js/appointment-modal.js') }}" defer></script>
  <script src="{{ asset('js/pages/dashboard.js') }}" defer></script>
  <script src="{{ asset('js/pages/appointments.js') }}" defer></script>
  <script src="{{ asset('js/pages/calendar.js') }}" defer></script>
  <script src="{{ asset('js/pages/booking.js') }}" defer></script>
  <script src="{{ asset('js/pages/services.js') }}" defer></script>
  <script src="{{ asset('js/pages/staff.js') }}" defer></script>
  <script src="{{ asset('js/pages/customers.js') }}" defer></script>
  <script src="{{ asset('js/pages/settings.js') }}" defer></script>
  <script src="{{ asset('js/pages/branches.js') }}" defer></script>
  <script src="{{ asset('js/pages/resources.js') }}" defer></script>
  <script src="{{ asset('js/pages/booking-page.js') }}" defer></script>
  <script src="{{ asset('js/pages/manage-booking.js') }}" defer></script>
  <script src="{{ asset('js/pages/notifications.js') }}" defer></script>
  <script src="{{ asset('js/pages/reports.js') }}" defer></script>
  <script src="{{ asset('js/pages/integrations.js') }}" defer></script>
  <script src="{{ asset('js/pages/billing.js') }}" defer></script>
  <script src="{{ asset('js/pages/till.js') }}" defer></script>
  <script src="{{ asset('js/pages/receipt.js') }}" defer></script>
  <script src="{{ asset('js/pages/marketing.js') }}" defer></script>
</head>
<body class="{% block body_class %}min-h-full bg-surface text-ink antialiased{% endblock %}">
  <a href="#main" class="skip-link">{{ t('common.skip_to_content') }}</a>
  {% block body %}{% endblock %}
  <div id="toast-region" class="toast-region" aria-live="polite" aria-atomic="false"></div>
</body>
</html>{% endif %}
