{#
  Platform admin shell (auth.md §10). Sidebar navigation like the tenant portal,
  but with a persistent "Platform" badge so admins always know which boundary
  they are in. Nav is permission-aware; server checks still gate every route.
#}
{% extends 'layouts/base.twig' %}

{% block body %}
{% set sections = [
  { title: t('nav.platform'), items: [
    { key: 'overview', label: t('nav.overview'), icon: 'fa-gauge', href: '/dashboard' },
    { key: 'leads', label: t('nav.leads'), icon: 'fa-inbox', href: '/leads' },
    { key: 'plans', label: t('nav.plans'), icon: 'fa-layer-group', href: '/plans' },
    { key: 'audit_logs', label: t('nav.audit_logs'), icon: 'fa-scroll', href: '/audit-logs' },
    { key: 'components', label: t('nav.components'), icon: 'fa-puzzle-piece', href: '/_system/components' },
  ]},
] %}
<div class="min-h-screen lg:flex">
  {% include 'components/layout/sidebar.twig' with {
    brand: app_name,
    workspace: t('nav.platform'),
    active: active_nav|default('overview'),
    sections: sections,
  } only %}

  <div class="flex min-w-0 flex-1 flex-col">
    <header class="topbar">
      <div class="flex items-center gap-3">
        <button type="button" class="icon-button lg:hidden" data-drawer-toggle="sidebar" aria-controls="sidebar" aria-expanded="false">
          <i class="fa-solid fa-bars" aria-hidden="true"></i><span class="sr-only">{{ t('common.open_menu') }}</span>
        </button>
        <h1 class="text-xl font-semibold text-ink sm:text-2xl">{{ page_title|default(t('nav.platform')) }}</h1>
        <span class="rounded-md bg-navy/10 px-2 py-0.5 text-xs font-semibold uppercase tracking-wide text-navy">{{ t('nav.platform') }}</span>
      </div>
      <div class="flex items-center gap-3">
        {% if admin_email|default('') is not empty %}
          <span class="hidden text-sm text-muted sm:inline">{{ admin_email }}</span>
        {% endif %}
        <form method="post" action="/logout">
          {{ csrf_field() }}
          <button type="submit" class="btn btn-secondary btn-sm">{{ t('auth.sign_out') }}</button>
        </form>
      </div>
    </header>
    <main id="main" class="flex-1 px-4 py-6 sm:px-6 lg:px-8" tabindex="-1">
      {% block content %}{% endblock %}
    </main>
  </div>
</div>
{% endblock %}
