{% extends 'layouts/admin.twig' %}

{% block title %}{{ t('nav.platform') }} · {{ app_name }}{% endblock %}

{% block content %}
  <h1 class="text-2xl font-semibold text-ink">{{ t('admin.home_title') }}</h1>
  <p class="mt-2 text-muted">{{ t('admin.home_body') }}</p>

  <div class="mt-6 grid gap-4 sm:grid-cols-3">
    {% include 'components/data/stat-card.twig' with { label: t('admin.kpi_tenants'), value: '—', icon: 'fa-building' } only %}
    {% include 'components/data/stat-card.twig' with { label: t('admin.kpi_trials'), value: '—', icon: 'fa-flask' } only %}
    {% include 'components/data/stat-card.twig' with { label: t('admin.kpi_failures'), value: '—', icon: 'fa-triangle-exclamation' } only %}
  </div>
{% endblock %}
