{#
  Thermal-style customer receipt (80 / 58 mm). Layout follows the AlbaBook
  receipt design: business header → black heading bar → receipt facts →
  items → inclusive levies → total bar → tenders (masked references) and the
  payment status → verification QR → thank-you footer. Every optional part is
  driven by ReceiptSettings; all amounts are server-computed.
#}
{% extends 'layouts/base.twig' %}

{% set page_scripts = ['pages/receipt.js'] %}

{% block title %}{{ t('receipt.title') }} {{ r.reference }} · {{ business_name }}{% endblock %}

{% block body_class %}min-h-full bg-surface text-ink antialiased{% endblock %}

{% block body %}
<main id="main" class="receipt-page" tabindex="-1" data-page="receipt">
  <div class="receipt-toolbar no-print">
    <a href="{{ back_url }}" class="btn btn-ghost btn-sm">
      <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> {{ t('common.back') }}
    </a>
    {% if is_preview %}<span class="badge badge-info">{{ t('receipt.preview_badge') }}</span>{% endif %}
    <button type="button" class="btn btn-primary btn-sm" data-print>
      <i class="fa-solid fa-print" aria-hidden="true"></i> {{ t('receipt.print') }}
    </button>
  </div>

  <article class="receipt receipt--{{ settings.paper }}" aria-label="{{ t('receipt.title') }}">
    {# ---------------------------------------------------------- Header #}
    <header class="receipt-header">
      {% if settings.logo == 'initial' %}
        <div class="receipt-logo receipt-logo--initial" aria-hidden="true">{{ logo_initial }}</div>
      {% elseif settings.logo != 'none' %}
        <div class="receipt-logo" aria-hidden="true"><i class="fa-solid fa-{{ settings.logo }}"></i></div>
      {% endif %}
      <h1 class="receipt-business">{{ business_name|upper }}</h1>
      {% if settings.tagline %}<p class="receipt-tagline">{{ settings.tagline|upper }}</p>{% endif %}
      {% if settings.show_address and address %}
        <p class="receipt-meta"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> {{ address }}</p>
      {% endif %}
      {% if settings.show_phone and phone %}
        <p class="receipt-meta"><i class="fa-solid fa-phone" aria-hidden="true"></i> {{ phone }}</p>
      {% endif %}
      {% if settings.show_email and r.branch_email|default('') %}
        <p class="receipt-meta"><i class="fa-solid fa-envelope" aria-hidden="true"></i> {{ r.branch_email }}</p>
      {% endif %}
      {% if settings.show_kra_pin and r.kra_pin|default('') %}
        <p class="receipt-meta">KRA PIN: {{ r.kra_pin }}</p>
      {% endif %}
    </header>

    <hr class="receipt-dash">
    <h2 class="receipt-bar">{{ settings.heading|upper }}</h2>

    {# ---------------------------------------------------------- Facts #}
    <dl class="receipt-rows receipt-mono">
      <div><dt>{{ t('receipt.no') }}:</dt><dd>{{ r.reference }}</dd></div>
      <div><dt>{{ t('receipt.date') }}:</dt><dd>{{ date }} &nbsp;{{ t('receipt.time') }}: {{ time }}</dd></div>
      {% if settings.show_customer %}
        <div><dt>{{ t('receipt.customer') }}:</dt><dd class="receipt-wrap">{{ r.customer_name_snapshot|default(t('receipt.walk_in')) }}</dd></div>
      {% endif %}
      {% if service_summary %}
        <div><dt>{{ t('receipt.service') }}:</dt><dd class="receipt-wrap">{{ service_summary }}</dd></div>
      {% endif %}
      {% if settings.show_staff and r.staff_name|default('') %}
        <div><dt>{{ t('receipt.staff') }}:</dt><dd class="receipt-wrap">{{ r.staff_name }}</dd></div>
      {% endif %}
    </dl>

    <hr class="receipt-dash">

    {# ---------------------------------------------------------- Items #}
    <table class="receipt-items receipt-mono">
      <thead>
        <tr>
          <th scope="col" class="text-left">{{ t('receipt.col_description') }}</th>
          <th scope="col" class="text-center">{{ t('receipt.col_qty') }}</th>
          <th scope="col" class="text-right">{{ t('receipt.col_amount') }}</th>
        </tr>
      </thead>
      <tbody>
        {% for item in items %}
          <tr>
            <td>{{ item.label }}</td>
            <td class="text-center">{{ item.qty }}</td>
            <td class="text-right whitespace-nowrap">{{ item.amount }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>

    <hr class="receipt-dash">

    {# ---------------------------------------------------------- Totals #}
    <dl class="receipt-rows receipt-mono">
      <div><dt>{{ t('receipt.subtotal') }}:</dt><dd>{{ lines.subtotal }}</dd></div>
      {% if lines.discount %}<div><dt>{{ t('receipt.discount') }}:</dt><dd>−{{ lines.discount }}</dd></div>{% endif %}
      {% if lines.vat %}<div class="receipt-row-sm"><dt>{{ t('receipt.vat_inclusive', { rate: lines.vat_rate }) }}:</dt><dd>{{ lines.vat }}</dd></div>{% endif %}
      {% if lines.service_charge %}<div class="receipt-row-sm"><dt>{{ t('receipt.service_charge_inclusive', { rate: lines.service_charge_rate }) }}:</dt><dd>{{ lines.service_charge }}</dd></div>{% endif %}
      {% if lines.tips %}<div><dt>{{ t('receipt.tips') }}:</dt><dd>{{ lines.tips }}</dd></div>{% endif %}
    </dl>

    <div class="receipt-total-bar">
      <span>{{ fully_paid ? t('receipt.total_paid') : t('receipt.total') }}:</span>
      <span>{{ lines.total }}</span>
    </div>
    {% if not fully_paid %}
      <dl class="receipt-rows receipt-mono">
        <div><dt>{{ t('receipt.paid') }}:</dt><dd>{{ lines.paid }}</dd></div>
        {% if lines.balance %}<div class="receipt-row-strong"><dt>{{ t('receipt.balance_due') }}:</dt><dd>{{ lines.balance }}</dd></div>{% endif %}
      </dl>
    {% endif %}

    {# ---------------------------------------------------------- Payment #}
    <dl class="receipt-rows receipt-mono receipt-payment">
      {% for tender in tenders %}
        <div><dt>{{ t('receipt.payment_method') }}:</dt><dd>{{ tender.method }}{% if tenders|length > 1 %} · {{ tender.amount }}{% endif %}</dd></div>
        {% if tender.reference %}<div><dt>{{ tender.reference_label }}:</dt><dd class="receipt-wrap">{{ tender.reference }}</dd></div>{% endif %}
      {% else %}
        <div><dt>{{ t('receipt.payment_method') }}:</dt><dd>—</dd></div>
      {% endfor %}
      <div class="receipt-status-row">
        <dt>{{ t('receipt.payment_status') }}:</dt>
        <dd>
          <span class="receipt-status receipt-status--{{ status.tone }}">
            {% if status.tone == 'paid' %}<i class="fa-solid fa-circle-check" aria-hidden="true"></i>{% endif %}
            <span class="receipt-status-pill">{{ status.label|upper }}</span>
          </span>
        </dd>
      </div>
    </dl>

    {# ---------------------------------------------------------- eTIMS #}
    {% if etims %}
      <hr class="receipt-dash">
      <section class="receipt-etims" aria-label="{{ t('receipt.etims_heading') }}">
        <p class="receipt-etims-title">{{ t('receipt.etims_heading') }}</p>
        {% if etims.status == 'submitted' %}
          <dl class="receipt-rows receipt-mono receipt-row-sm">
            {% if etims.sdc_id %}<div><dt>{{ t('receipt.etims_cu_serial') }}:</dt><dd>{{ etims.sdc_id }}</dd></div>{% endif %}
            <div><dt>{{ t('receipt.etims_cu_invoice') }}:</dt><dd>{{ etims.sdc_id ? etims.sdc_id ~ '/' : '' }}{{ etims.rcpt_no }}</dd></div>
            <div><dt>{{ t('receipt.etims_invoice_no') }}:</dt><dd>{{ etims.invoice_no }}</dd></div>
            {% if etims.sdc_date_time %}<div><dt>{{ t('receipt.date') }}:</dt><dd>{{ etims.sdc_date_time }}</dd></div>{% endif %}
            <div><dt>{{ t('receipt.etims_internal_data') }}:</dt><dd class="receipt-wrap break-all">{{ etims.intrl_data }}</dd></div>
            <div><dt>{{ t('receipt.etims_signature') }}:</dt><dd class="receipt-wrap break-all">{{ etims.rcpt_sign }}</dd></div>
          </dl>
          {% if etims_qr_b64 %}
            <figure class="receipt-qr">
              <img src="data:image/svg+xml;base64,{{ etims_qr_b64 }}" width="130" height="130" alt="{{ t('receipt.etims_qr_alt') }}">
              <figcaption><span class="receipt-qr-title">{{ t('receipt.etims_scan') }}</span></figcaption>
            </figure>
          {% endif %}
        {% else %}
          <p class="receipt-meta">{{ t('receipt.etims_pending', { no: etims.invoice_no }) }}</p>
        {% endif %}
      </section>
    {% endif %}

    {# ---------------------------------------------------------- Verify #}
    {% if qr_svg_b64 %}
      <hr class="receipt-dash">
      <figure class="receipt-qr">
        <img src="data:image/svg+xml;base64,{{ qr_svg_b64 }}" width="150" height="150" alt="{{ t('receipt.qr_alt') }}">
        <figcaption>
          <span class="receipt-qr-title">{{ t('receipt.scan_to_verify') }}</span>
          <span class="receipt-qr-url">{{ verify_display }}</span>
        </figcaption>
      </figure>
    {% endif %}

    <hr class="receipt-dash">
    <footer class="receipt-footer">
      <p class="receipt-thanks">{{ footer_note ?: t('receipt.thanks_for_choosing', { name: business_name|upper }) }}</p>
      {% if not etims %}<p class="receipt-meta">{{ t('receipt.not_a_tax_invoice') }}</p>{% endif %}
      {% if show_powered_by %}<p class="receipt-powered">{{ t('common.powered_by') }}</p>{% endif %}
    </footer>
  </article>
</main>
{% endblock %}
