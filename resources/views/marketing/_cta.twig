{# Closing call-to-action band. Params: signup_url #}
<section class="px-4 pb-20 sm:px-6 lg:px-8">
  <div class="cta-band reveal">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Ready to fill your calendar?</h2>
      <p class="mt-4 text-lg text-white/70">Create your account, add your services and share your booking link — today.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="{{ signup_url }}" class="btn btn-lg bg-white text-primary-strong hover:bg-primary-soft" data-no-spa>Start free</a>
        <a href="/contact" class="btn btn-lg border border-white/25 text-white hover:bg-white/10">Talk to us first</a>
      </div>
    </div>
  </div>
</section>
