{#
  Illustrative product preview built from the real dashboard classes (navy
  sidebar, stat cards, calendar event chips) so the site shows the actual
  design system. Decorative: hidden from assistive tech; the page copy carries
  the meaning.
#}
<div class="mockup" aria-hidden="true">
  <div class="mockup-chrome">
    <span class="mockup-dot bg-danger/70"></span><span class="mockup-dot bg-warning/80"></span><span class="mockup-dot bg-success/80"></span>
    <span class="mockup-url"><i class="fa-solid fa-lock text-[10px]"></i> app.albabook.co.ke/dashboard</span>
  </div>
  <div class="flex">
    <div class="mockup-sidebar">
      <div class="flex items-center gap-2 px-2 pb-4 text-xs font-semibold text-white"><span class="brand-mark h-6 w-6 text-[10px]">A</span>Glow Studio</div>
      {% for item in [
        { icon: 'fa-gauge', label: 'Overview', active: true },
        { icon: 'fa-calendar-days', label: 'Calendar' },
        { icon: 'fa-clipboard-list', label: 'Appointments' },
        { icon: 'fa-scissors', label: 'Services' },
        { icon: 'fa-user-group', label: 'Staff' },
        { icon: 'fa-chart-line', label: 'Reports' },
      ] %}
        <div class="mockup-nav{% if item.active ?? false %} is-active{% endif %}"><i class="fa-solid {{ item.icon }} w-3.5"></i>{{ item.label }}</div>
      {% endfor %}
    </div>
    <div class="min-w-0 flex-1 bg-surface p-3 sm:p-4">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-[11px] text-muted">Today</p>
          <p class="text-sm font-semibold text-ink">Good morning, Wanjiru</p>
        </div>
        <span class="badge badge-success text-[10px]"><span class="badge-dot"></span>Booking page live</span>
      </div>
      <div class="mt-3 grid grid-cols-3 gap-2">
        {% for stat in [
          { label: 'Bookings', value: '24', icon: 'fa-calendar-check', trend: '+18%' },
          { label: 'Revenue', value: 'KES 41.2k', icon: 'fa-coins', trend: '+9%' },
          { label: 'No-shows', value: '1', icon: 'fa-user-xmark', trend: '−3' },
        ] %}
          <div class="card p-2.5">
            <div class="flex items-center justify-between">
              <p class="text-[10px] font-medium text-muted">{{ stat.label }}</p>
              <i class="fa-solid {{ stat.icon }} text-[10px] text-primary"></i>
            </div>
            <p class="mt-1 text-sm font-semibold text-ink sm:text-base">{{ stat.value }}</p>
            <p class="text-[10px] text-success-strong"><i class="fa-solid fa-arrow-trend-up"></i> {{ stat.trend }}</p>
          </div>
        {% endfor %}
      </div>
      <div class="card mt-2 p-2.5">
        <div class="flex items-center justify-between">
          <p class="text-[11px] font-semibold text-ink">Schedule</p>
          <p class="text-[10px] text-muted">3 staff · Westlands</p>
        </div>
        <div class="mt-2 grid grid-cols-3 gap-1.5">
          {% for col in [
            [{ t: '09:00', n: 'Braids · Amina', s: 'cal-confirmed', h: 'h-14' }, { t: '11:30', n: 'Trim · Otieno', s: 'cal-pending', h: 'h-8' }],
            [{ t: '09:30', n: 'Facial · Njeri', s: 'cal-checked_in', h: 'h-10' }, { t: '10:30', n: 'Massage · Kevin', s: 'cal-confirmed', h: 'h-12' }],
            [{ t: '10:00', n: 'Manicure · Faith', s: 'cal-confirmed', h: 'h-9' }, { t: '11:00', n: 'Colour · Mercy', s: 'cal-completed', h: 'h-12' }],
          ] %}
            <div class="space-y-1.5">
              {% for ev in col %}
                <div class="mockup-event {{ ev.s }} {{ ev.h }}"><span class="font-semibold">{{ ev.t }}</span><br>{{ ev.n }}</div>
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>
