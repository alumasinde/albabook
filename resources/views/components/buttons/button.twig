{#
  One button component, four variants (plan.md §16, dashboard.md §6).
  Params: label, variant? (primary|secondary|danger|ghost), type? (button|submit), href?,
          icon? (Font Awesome name, e.g. "fa-plus"), size? (md|sm|lg), full_width?, disabled?, loading?,
          attrs? ({ name: value } extra data-/aria- attributes)
  Critical actions always have visible text (plan.md §22.2: no icon-only critical actions).
#}
{% set classes = 'btn btn-' ~ variant|default('primary') ~ ' btn-' ~ size|default('md') ~ (full_width|default(false) ? ' w-full' : '') %}
{% set extra %}{% for key, attr_value in attrs|default({}) %} {{ key }}="{{ attr_value }}"{% endfor %}{% endset %}
{% if href|default('') %}
  <a href="{{ href }}" class="{{ classes }}"{{ extra|raw }}>
    {% if icon|default('') %}<i class="fa-solid {{ icon }}" aria-hidden="true"></i>{% endif %}<span>{{ label }}</span>
  </a>
{% else %}
  <button type="{{ type|default('button') }}" class="{{ classes }}"{% if disabled|default(false) or loading|default(false) %} disabled{% endif %}{% if loading|default(false) %} aria-busy="true"{% endif %}{{ extra|raw }}>
    {% if loading|default(false) %}<span class="spinner" aria-hidden="true"></span>{% elseif icon|default('') %}<i class="fa-solid {{ icon }}" aria-hidden="true"></i>{% endif %}<span>{{ label }}</span>
  </button>
{% endif %}
