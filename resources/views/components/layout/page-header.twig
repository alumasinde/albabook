{# Params: title, description?, actions? (raw HTML block rendered by caller via embed) #}
<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div>
    <h2 class="text-2xl font-semibold text-ink">{{ title }}</h2>
    {% if description|default('') %}<p class="mt-1 text-sm text-muted">{{ description }}</p>{% endif %}
  </div>
  {% block actions %}{% endblock %}
</div>
