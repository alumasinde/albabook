{#
  Top bar (dashboard.md §2A). Params: title.
  Branch selector, notifications and profile become live in Phase 2/5.
#}
<header class="topbar">
  <div class="flex items-center gap-3">
    <button type="button" class="icon-button lg:hidden" data-drawer-toggle="sidebar" aria-controls="sidebar" aria-expanded="false">
      <i class="fa-solid fa-bars" aria-hidden="true"></i><span class="sr-only">{{ t('common.open_menu') }}</span>
    </button>
    <h1 class="text-xl font-semibold text-ink sm:text-2xl">{{ title }}</h1>
  </div>
  <div class="flex items-center gap-2">
    <button type="button" class="icon-button" aria-label="{{ t('nav.notifications') }}">
      <i class="fa-regular fa-bell" aria-hidden="true"></i>
    </button>
    <span class="avatar" aria-hidden="true">RB</span>
  </div>
</header>
