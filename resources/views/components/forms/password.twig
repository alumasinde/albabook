{#
  Password input with a visibility toggle (auth.md §6). The toggle is a real button
  wired by app.js via data attributes; no inline handlers (CSP).
  Params: name, label, error?, help?, required?, autocomplete? (current-password|new-password), id?
#}
{% set id = id|default('field-' ~ name) %}
{% set describedby = [help|default('') ? id ~ '-help' : null, error|default('') ? id ~ '-error' : null]|filter(v => v) %}
<div class="field">
  <label for="{{ id }}" class="field-label">{{ label }}{% if required|default(false) %} <span class="text-danger" aria-hidden="true">*</span>{% endif %}</label>
  <div class="relative">
    <input id="{{ id }}" name="{{ name }}" type="password" class="input pr-12{% if error|default('') %} is-invalid{% endif %}"
      autocomplete="{{ autocomplete|default('current-password') }}"
      {%- if required|default(false) %} required aria-required="true"{% endif %}
      {%- if error|default('') %} aria-invalid="true"{% endif %}
      {%- if describedby is not empty %} aria-describedby="{{ describedby|join(' ') }}"{% endif %}>
    <button type="button" class="password-toggle" data-password-toggle="{{ id }}" aria-controls="{{ id }}" aria-pressed="false">
      <i class="fa-regular fa-eye" aria-hidden="true"></i><span class="sr-only">{{ t('forms.show_password') }}</span>
    </button>
  </div>
  {% if help|default('') %}<p id="{{ id }}-help" class="field-help">{{ help }}</p>{% endif %}
  {% include 'components/forms/form-error.twig' with { id: id ~ '-error', message: error|default('') } only %}
</div>
