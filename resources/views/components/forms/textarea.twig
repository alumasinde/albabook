{# Params: name, label, value?, rows?, maxlength?, error?, help?, required?, id? #}
{% set id = id|default('field-' ~ name) %}
{% set describedby = [help|default('') ? id ~ '-help' : null, error|default('') ? id ~ '-error' : null]|filter(v => v) %}
<div class="field">
  <label for="{{ id }}" class="field-label">{{ label }}{% if required|default(false) %} <span class="text-danger" aria-hidden="true">*</span>{% endif %}</label>
  <textarea id="{{ id }}" name="{{ name }}" rows="{{ rows|default(4) }}" class="input{% if error|default('') %} is-invalid{% endif %}"
    {%- if maxlength|default(0) %} maxlength="{{ maxlength }}"{% endif %}
    {%- if required|default(false) %} required aria-required="true"{% endif %}
    {%- if error|default('') %} aria-invalid="true"{% endif %}
    {%- if describedby is not empty %} aria-describedby="{{ describedby|join(' ') }}"{% endif %}>{{ value|default('') }}</textarea>
  {% if help|default('') %}<p id="{{ id }}-help" class="field-help">{{ help }}</p>{% endif %}
  {% include 'components/forms/form-error.twig' with { id: id ~ '-error', message: error|default('') } only %}
</div>
