{#
  Persistent banner while a platform administrator is inside a tenant workspace
  through an audited support session (multi-tenancy.md §7). Present on every
  dashboard page, never dismissible.
#}
{% if support_session %}
<div class="border-b border-warning/40 bg-warning-soft">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-2 px-4 py-2.5 text-sm text-ink sm:px-6 lg:px-8">
    <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
      <i class="fa-solid fa-user-shield text-warning-strong" aria-hidden="true"></i>
      <span class="font-semibold">{{ support_session.write_allowed ? t('admin.support_write_status') : t('admin.support_read_only_status') }}</span>
      <span class="text-muted">{{ t('admin.support_banner_reason', { reason: support_session.reason }) }}</span>
      <span class="text-muted">{{ t('admin.support_banner_expires', { time: support_session.expires_at|date('H:i', 'UTC') }) }} UTC</span>
    </p>
    <a href="/support/exit" class="font-semibold text-primary-strong hover:underline">{{ t('admin.support_exit') }}</a>
  </div>
</div>
{% endif %}
