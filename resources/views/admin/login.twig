{% extends 'layouts/auth.twig' %}

{% block title %}{{ t('admin.login_title') }} · {{ app_name }}{% endblock %}

{% block content %}
<p class="inline-flex items-center gap-2 rounded-full bg-navy px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white">
  <i class="fa-solid fa-lock" aria-hidden="true"></i>{{ t('nav.platform') }}
</p>
<h1 class="mt-4 text-2xl font-semibold text-ink">{{ t('admin.login_title') }}</h1>
<p class="mt-1 text-sm text-muted">{{ t('admin.login_subtitle') }}</p>

{% if status == 'mfa_locked' %}
  <div class="mt-6">
    {% include 'components/feedback/alert.twig' with { tone: 'danger', message: t('auth.mfa_locked'), dismissible: true } only %}
  </div>
{% endif %}
{% if error %}
  <div class="mt-6">
    {% include 'components/feedback/alert.twig' with { tone: 'danger', message: error } only %}
  </div>
{% endif %}

<form method="post" action="/login" class="mt-6 space-y-5" novalidate>
  {{ csrf_field() }}
  {% include 'components/forms/input.twig' with {
    name: 'email', label: t('auth.email'), type: 'email', value: email,
    autocomplete: 'email', inputmode: 'email', required: true,
  } only %}
  {% include 'components/forms/password.twig' with {
    name: 'password', label: t('auth.password'),
    autocomplete: 'current-password', required: true,
  } only %}
  {% include 'components/buttons/button.twig' with { label: t('auth.submit_login'), type: 'submit', full_width: true } only %}
</form>

<p class="mt-8 text-xs text-muted">{{ t('admin.restricted') }}</p>
{% endblock %}
