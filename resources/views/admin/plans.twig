{% extends 'layouts/admin.twig' %}

{% block title %}Plans & subscriptions · {{ app_name }}{% endblock %}

{% block content %}
{% if status == 'created' %}
  {% include 'components/feedback/alert.twig' with { tone: 'success', message: 'Plan created.', dismissible: true } only %}
{% elseif status == 'updated' %}
  {% include 'components/feedback/alert.twig' with { tone: 'success', message: 'Plan updated.', dismissible: true } only %}
{% elseif status == 'toggled' %}
  {% include 'components/feedback/alert.twig' with { tone: 'success', message: 'Plan availability updated.', dismissible: true } only %}
{% elseif status == 'deleted' %}
  {% include 'components/feedback/alert.twig' with { tone: 'success', message: 'Plan deleted.', dismissible: true } only %}
{% elseif status == 'delete_blocked' %}
  {% include 'components/feedback/alert.twig' with { tone: 'danger', message: 'That plan has subscription history — deactivate it instead.', dismissible: true } only %}
{% elseif status == 'not_found' %}
  {% include 'components/feedback/alert.twig' with { tone: 'danger', message: 'Plan not found.', dismissible: true } only %}
{% endif %}

<div class="mt-2 flex items-center justify-between gap-4">
  <p class="text-sm text-muted">Plans gate what each business can use — price, billing interval and feature limits. Live subscriptions keep their current period when a plan is deactivated.</p>
  <a href="/plans/new" class="btn btn-primary btn-sm shrink-0">
    <i class="fa-solid fa-plus" aria-hidden="true"></i> New plan
  </a>
</div>

{% if plans is empty %}
  <section class="card mt-6 p-10 text-center">
    <i class="fa-solid fa-layer-group text-3xl text-muted" aria-hidden="true"></i>
    <p class="mt-3 text-sm text-muted">No plans yet. Create the first one to start assigning subscriptions.</p>
    <a href="/plans/new" class="btn btn-primary mt-4">Create a plan</a>
  </section>
{% else %}
  <div class="mt-6 grid gap-4 lg:grid-cols-2">
    {% for plan in plans %}
      <section class="card p-5" aria-labelledby="plan-{{ plan.uuid }}">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h2 id="plan-{{ plan.uuid }}" class="text-lg font-semibold text-ink">{{ plan.name }}</h2>
            <p class="mt-0.5 text-xs text-muted">
              <code class="rounded bg-surface px-1.5 py-0.5">{{ plan.code }}</code>
              {% if plan.is_active %}
                <span class="ml-1 badge badge-success">Active</span>
              {% else %}
                <span class="ml-1 badge badge-neutral">Inactive</span>
              {% endif %}
            </p>
          </div>
          <p class="text-right">
            <span class="text-xl font-semibold text-ink">{{ plan.currency }} {{ (plan.price_minor / 100)|number_format(2) }}</span>
            <span class="block text-xs text-muted">/ {{ plan.billing_interval == 'yearly' ? 'year' : 'month' }}</span>
          </p>
        </div>

        {% if plan.description %}
          <p class="mt-3 text-sm text-muted">{{ plan.description }}</p>
        {% endif %}

        <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
          <div class="rounded-lg bg-surface px-3 py-2">
            <dt class="text-xs text-muted">Subscribers</dt>
            <dd class="font-semibold text-ink">{{ plan.subscribers }}</dd>
          </div>
          <div class="rounded-lg bg-surface px-3 py-2">
            <dt class="text-xs text-muted">Features enabled</dt>
            <dd class="font-semibold text-ink">{{ plan.enabled_features }} / {{ features|length }}</dd>
          </div>
        </dl>

        <div class="mt-4 flex items-center gap-2">
          <a href="/plans/{{ plan.uuid }}" class="btn btn-secondary btn-sm">
            <i class="fa-solid fa-pen" aria-hidden="true"></i> Edit
          </a>
          <form method="post" action="/plans/{{ plan.uuid }}/toggle">
            {{ csrf_field() }}
            <button type="submit" class="btn {{ plan.is_active ? 'btn-ghost' : 'btn-primary' }} btn-sm">
              {{ plan.is_active ? 'Deactivate' : 'Activate' }}
            </button>
          </form>
          {% if plan.subscribers == 0 %}
            <form method="post" action="/plans/{{ plan.uuid }}/delete">
              {{ csrf_field() }}
              <button type="submit" class="btn btn-ghost btn-sm text-danger">Delete</button>
            </form>
          {% endif %}
        </div>
      </section>
    {% endfor %}
  </div>
{% endif %}
{% endblock %}
