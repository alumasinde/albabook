{% extends 'layouts/admin.twig' %}

{% block title %}{{ plan ? 'Edit plan' : 'New plan' }} · {{ app_name }}{% endblock %}

{% block content %}
<p class="text-sm text-muted">
  <a href="/plans" class="text-primary hover:underline">&larr; Back to plans</a>
</p>

<section class="card mt-4 p-6">
  <form method="post" action="{{ plan ? '/plans/' ~ plan.uuid : '/plans' }}" novalidate>
    {{ csrf_field() }}
    <div class="grid gap-5 sm:grid-cols-2">
      {% include 'components/forms/input.twig' with {
        name: 'code', label: 'Code', value: data.code, error: errors.code|default(''),
        required: true, placeholder: 'e.g. growth',
        help: 'Stable identifier — lowercase letters, digits, dashes, underscores.',
      } only %}
      {% include 'components/forms/input.twig' with {
        name: 'name', label: 'Name', value: data.name, error: errors.name|default(''),
        required: true, placeholder: 'e.g. Growth',
      } only %}
      {% include 'components/forms/input.twig' with {
        name: 'price', label: 'Price (major units)', value: data.price, type: 'number',
        error: errors.price|default(''), required: true, inputmode: 'decimal', placeholder: '1500.00',
      } only %}
      {% include 'components/forms/select.twig' with {
        name: 'currency', label: 'Currency', value: data.currency, required: true,
        options: currencies|map(c => { value: c.code, label: c.code ~ ' — ' ~ c.name }),
      } only %}
      {% include 'components/forms/select.twig' with {
        name: 'billing_interval', label: 'Billing interval', value: data.billing_interval, required: true,
        options: [
          { value: 'monthly', label: 'Monthly' },
          { value: 'yearly', label: 'Yearly' },
        ],
      } only %}
      {% include 'components/forms/input.twig' with {
        name: 'sort_position', label: 'Sort position', value: data.sort_position, type: 'number',
        help: 'Lower numbers show first in plan pickers.',
      } only %}
    </div>

    <div class="field mt-5">
      <label for="field-description" class="field-label">Description</label>
      <textarea id="field-description" name="description" rows="2" maxlength="500"
        class="input{% if errors.description|default('') %} is-invalid{% endif %}">{{ data.description }}</textarea>
      {% if errors.description|default('') %}<p class="mt-1 text-sm text-danger">{{ errors.description }}</p>{% endif %}
    </div>

    <label class="mt-4 flex items-center gap-2 text-sm text-ink">
      <input type="checkbox" name="is_active" value="1"{% if data.is_active %} checked{% endif %} class="h-4 w-4 rounded border-line text-primary">
      Plan can be assigned to businesses
    </label>

    <fieldset class="mt-6">
      <legend class="text-sm font-semibold text-ink">Features</legend>
      <p class="mt-1 text-xs text-muted">Unchecked features are unavailable on this plan. Limit features take a whole number — empty means unlimited.</p>
      {% if errors.features|default('') %}
        <p class="mt-2 text-sm text-danger">{{ errors.features }}</p>
      {% endif %}
      <div class="mt-3 overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-line text-left text-xs uppercase tracking-wide text-muted">
              <th class="py-2 pr-4 font-semibold">Feature</th>
              <th class="py-2 pr-4 font-semibold">Included</th>
              <th class="py-2 font-semibold">Limit</th>
            </tr>
          </thead>
          <tbody>
            {% for feature in features %}
              {% set current = featureMap[feature.code]|default(null) %}
              <tr class="border-b border-line/60">
                <td class="py-2 pr-4">
                  <span class="font-medium text-ink">{{ feature.name }}</span>
                  <span class="block text-xs text-muted"><code>{{ feature.code }}</code></span>
                </td>
                <td class="py-2 pr-4">
                  <input type="checkbox" name="features[{{ feature.code }}][enabled]" value="1"
                    {% if current and current.is_enabled %} checked{% endif %}
                    class="h-4 w-4 rounded border-line text-primary"
                    aria-label="Enable {{ feature.name }}">
                </td>
                <td class="py-2">
                  {% if feature.value_type == 'limit' %}
                    <input type="number" name="features[{{ feature.code }}][limit]" min="0" inputmode="numeric"
                      value="{{ current and current.limit_value is not null ? current.limit_value : '' }}"
                      placeholder="Unlimited"
                      class="input w-32" aria-label="Limit for {{ feature.name }}{{ feature.unit ? ' (' ~ feature.unit ~ ')' : '' }}">
                    <span class="ml-1 text-xs text-muted">{{ feature.unit }}</span>
                  {% else %}
                    <span class="text-xs text-muted">—</span>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </fieldset>

    <div class="mt-6 flex items-center gap-3">
      <button type="submit" class="btn btn-primary">{{ plan ? 'Save changes' : 'Create plan' }}</button>
      <a href="/plans" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</section>

{% if plan %}
  <section class="card mt-6 p-6" aria-labelledby="subscribers-heading">
    <h2 id="subscribers-heading" class="text-lg font-semibold text-ink">Subscribers</h2>
    {% if subscribers is empty %}
      <p class="mt-3 text-sm text-muted">No business is currently on this plan.</p>
    {% else %}
      <div class="mt-3 overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-line text-left text-xs uppercase tracking-wide text-muted">
              <th class="py-2 pr-4 font-semibold">Business</th>
              <th class="py-2 pr-4 font-semibold">Subscription</th>
              <th class="py-2 font-semibold">Period ends</th>
            </tr>
          </thead>
          <tbody>
            {% for sub in subscribers %}
              <tr class="border-b border-line/60">
                <td class="py-2 pr-4">
                  <span class="font-medium text-ink">{{ sub.name }}</span>
                  <span class="block text-xs text-muted">{{ sub.slug }} · {{ sub.tenant_status }}</span>
                </td>
                <td class="py-2 pr-4">
                  <span class="badge badge-{{ sub.status == 'active' ? 'success' : (sub.status == 'trialing' ? 'info' : 'warning') }}">{{ sub.status }}</span>
                </td>
                <td class="py-2 text-muted">{{ sub.current_period_end }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </section>
{% endif %}
{% endblock %}
