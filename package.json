{
  "name": "albabook-assets",
  "private": true,
  "description": "Front-end build for AlbaBook. Node is used only to compile CSS and copy vendor assets; nothing runs in the browser from a CDN.",
  "scripts": {
    "build": "npm run build:css && node scripts/build-assets.mjs",
    "build:css": "tailwindcss -i resources/css/app.css -o public/assets/css/app.css --minify",
    "watch:css": "tailwindcss -i resources/css/app.css -o public/assets/css/app.css --watch"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.2.5",
    "@fortawesome/fontawesome-free": "6.7.2",
    "tailwindcss": "3.4.17"
  }
}
