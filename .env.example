# AlbaBook environment template. Copy to .env (or .env.production) and fill in.
# Never commit real values. Startup lists every missing or invalid setting.

# --- App ---
# Product name shown in pages and e-mails
APP_NAME=AlbaBook
# local | testing | staging | production
APP_ENV=local
# Show error details; must be false in production
APP_DEBUG=true
# 32 random bytes, "base64:..." (php bin/console key:generate)
APP_KEY=

# --- Hosts (hostnames only, no scheme or port) ---
# Business dashboard
APP_HOST_TENANT=app.albabook.localhost
# Public booking pages
APP_HOST_BOOKING=book.albabook.localhost
# API and webhooks (M-Pesa callbacks land here)
APP_HOST_API=api.albabook.localhost
# AlbaBook platform admin
APP_HOST_ADMIN=admin.albabook.localhost
# Marketing site (bare domain)
APP_HOST_MARKETING=albabook.localhost

# --- New-tenant defaults ---
# Timezone given to new businesses (app itself runs in UTC)
DEFAULT_TENANT_TIMEZONE=Africa/Nairobi
# Currency given to new businesses
DEFAULT_TENANT_CURRENCY=KES

# --- Security ---
# Proxy IPs/CIDRs allowed to set X-Forwarded-*; empty = none
TRUSTED_PROXIES=
# HTTPS-only cookies; true in production
SESSION_SECURE_COOKIE=false
# Optional IPs/CIDRs allowed on the admin host; empty = any
SECURITY_PLATFORM_IP_ALLOWLIST=

# --- Database (MySQL 8) ---
# Database host ("db" inside Docker)
DB_HOST=db
# Database port
DB_PORT=3306
# Database name
DB_DATABASE=albabook
# Runtime user (DML only in production)
DB_USERNAME=albabook
# Runtime user password
DB_PASSWORD=albabook
# Schema owner for migrations; empty = use DB_USERNAME
DB_MIGRATE_USERNAME=
# Schema owner password
DB_MIGRATE_PASSWORD=
# MySQL root password for the Docker db container
DB_ROOT_PASSWORD=
# Seconds to wait for a connection
DB_CONNECT_TIMEOUT=5

# --- Docker (local compose only) ---
# Host port for the web container
APP_PORT=8080
# Host port forwarded to MySQL
DB_FORWARD_PORT=33060

# --- Logging ---
# file | stderr
LOG_CHANNEL=file
# line | json
LOG_FORMAT=line
# debug | info | warning | error
LOG_LEVEL=debug
# Daily log files to keep
LOG_MAX_FILES=14

# --- Mail ---
# log (writes storage/logs/mail.log) | smtp (required in production)
MAIL_TRANSPORT=log
# SMTP server
MAIL_HOST=
# SMTP port
MAIL_PORT=587
# tls | ssl
MAIL_ENCRYPTION=tls
# SMTP username
MAIL_USERNAME=
# SMTP password
MAIL_PASSWORD=
# Sender address
MAIL_FROM_ADDRESS=no-reply@albabook.co.ke
# Sender name
MAIL_FROM_NAME=AlbaBook

# --- SMS (AlbaBook's platform account; empty provider = off) ---
# e.g. africastalking; empty disables the platform fallback
SMS_PROVIDER=
# Provider username
SMS_USERNAME=
# Provider API key
SMS_API_KEY=
# Shared sender ID registered with the provider
SMS_SENDER_ID=AlbaBook
# Platform account only texts these prefixes (anti-pumping)
SMS_ALLOWED_PREFIXES=+254

# --- WhatsApp (AlbaBook's platform number) ---
# meta | twilio; empty = off
WHATSAPP_PROVIDER=
# Meta phone number ID
WHATSAPP_PHONE_NUMBER_ID=
# Meta / Twilio access token
WHATSAPP_ACCESS_TOKEN=
# Sender number or ID
WHATSAPP_SENDER_ID=
# Platform number only messages these prefixes
WHATSAPP_ALLOWED_PREFIXES=+254

# --- Tenancy ---
# Extra reserved booking slugs, comma separated
TENANCY_RESERVED_SLUGS=
# Keep false until nginx and TLS serve custom domains
CUSTOM_DOMAINS_ENABLED=false

# --- M-Pesa callbacks (businesses enter their own Daraja keys in Settings) ---
# Public base for callbacks; a tunnel URL locally; empty = API host
MPESA_CALLBACK_BASE_URL=
# Optional Safaricom callback IPs/CIDRs; empty = any
MPESA_CALLBACK_IPS=

# --- AlbaBook subscription billing (AlbaBook's own Daraja app) ---
# Daraja consumer key
MPESA_BILLING_CONSUMER_KEY=
# Daraja consumer secret
MPESA_BILLING_CONSUMER_SECRET=
# Lipa na M-Pesa Online passkey
MPESA_BILLING_PASSKEY=
# sandbox | production
MPESA_BILLING_ENVIRONMENT=sandbox
# Till or paybill shortcode
MPESA_BILLING_SHORTCODE=
# Shortcode that receives the money
MPESA_BILLING_PARTY_B=
# true = till (Buy Goods), false = paybill
MPESA_BILLING_BUY_GOODS=true
# Signs invoice callback URLs (openssl rand -hex 32)
MPESA_BILLING_CALLBACK_SECRET=
# Days after period end before an unpaid workspace goes read-only
BILLING_GRACE_DAYS=7
# Days before period/trial end to issue the invoice
BILLING_LEAD_DAYS=5

# --- Ops signals (/health) ---
# Scheduler/workers count as stale after this
OPS_SCHEDULER_MAX_LAG_SECONDS=600
# Backups count as stale after this
OPS_BACKUP_MAX_AGE_SECONDS=93600
