# AlbaBook environment. Copy to .env and fill in. Never commit .env.
# Startup fails with a list of problems if a required value is missing or invalid.

APP_NAME=AlbaBook
# local | testing | staging | production
APP_ENV=local
APP_DEBUG=true
# 32 random bytes, base64-encoded, prefixed with "base64:".
# Generate with: php bin/console key:generate
APP_KEY=

# One host per interface (decisions.md D-005). Local hosts under *.localhost
# resolve to 127.0.0.1 in browsers without editing the hosts file.
APP_HOST_TENANT=app.albabook.localhost
APP_HOST_BOOKING=book.albabook.localhost
APP_HOST_API=api.albabook.localhost
APP_HOST_ADMIN=admin.albabook.localhost

# The application, PHP and the database session always run in UTC.
# These are only the defaults assigned to new tenants.
DEFAULT_TENANT_TIMEZONE=Africa/Nairobi
DEFAULT_TENANT_CURRENCY=KES

# Comma-separated IPs or CIDR ranges of reverse proxies whose X-Forwarded-*
# headers are trusted. Leave empty when PHP is reached directly.
TRUSTED_PROXIES=

# Defaults match docker-compose.yml (service "db", MySQL 8.4). Docker Compose
# also reads this file, so these values create the local database user.
# Use a strong, unique password anywhere other than local development.
DB_HOST=db
DB_PORT=3306
DB_DATABASE=albabook
DB_USERNAME=albabook
DB_PASSWORD=albabook

SESSION_SECURE_COOKIE=false

# MySQL 8 is required (D-009). Set to 1 only for Phase 1 local development on
# MariaDB; Docker and CI must leave it 0.
ALLOW_MARIADB=0

# file | stderr
LOG_CHANNEL=file
# line | json
LOG_FORMAT=line
LOG_LEVEL=debug
LOG_MAX_FILES=14

# log is the only transport until a delivery provider is configured.
MAIL_TRANSPORT=log
MAIL_FROM_ADDRESS=no-reply@albabook.co.ke
MAIL_FROM_NAME=AlbaBook

WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=

SMS_PROVIDER=africastalking
SMS_API_KEY=

ENCRYPTION_KEY=
