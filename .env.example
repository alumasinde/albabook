# AlbaBook environment. Copy to .env and fill in. Never commit .env.
# Startup fails with a list of problems if a required value is missing or invalid.

APP_NAME=AlbaBook
# local | testing | staging | production
APP_ENV=local
APP_DEBUG=true
# 32 random bytes, base64-encoded, prefixed with "base64:".
# Generate with: php bin/console key:generate
APP_KEY=

# One host per interface (decisions.md D-005). Local hosts under *.localhost
# resolve to 127.0.0.1 in browsers without editing the hosts file.
APP_HOST_TENANT=app.albabook.localhost
APP_HOST_BOOKING=book.albabook.localhost
APP_HOST_API=api.albabook.localhost
APP_HOST_ADMIN=admin.albabook.localhost
# Public marketing site (bare domain in production: albabook.co.ke).
APP_HOST_MARKETING=albabook.localhost

# The application, PHP and the database session always run in UTC.
# These are only the defaults assigned to new tenants.
DEFAULT_TENANT_TIMEZONE=Africa/Nairobi
DEFAULT_TENANT_CURRENCY=KES

# Comma-separated IPs or CIDR ranges of reverse proxies whose X-Forwarded-*
# headers are trusted. Leave empty when PHP is reached directly.
TRUSTED_PROXIES=

# Defaults match docker-compose.yml (service "db", MySQL 8.4). Docker Compose
# also reads this file, so these values create the local database user.
# Use a strong, unique password anywhere other than local development.
DB_HOST=db
DB_PORT=3306
DB_DATABASE=albabook
DB_USERNAME=albabook
DB_PASSWORD=albabook
# Production least privilege: a separate schema-owner account used only by
# `php bin/console migrate`; DB_USERNAME then needs DML only. Leave empty
# locally to migrate as DB_USERNAME.
DB_MIGRATE_USERNAME=
DB_MIGRATE_PASSWORD=
# Seconds to wait for the TCP connection (default 5). A dropping/firewalled
# database would otherwise hang requests for ~60s.
DB_CONNECT_TIMEOUT=5

SESSION_SECURE_COOKIE=false

# MySQL 8 is required (D-009). Set to 1 only for Phase 1 local development on
# MariaDB; Docker and CI must leave it 0.
ALLOW_MARIADB=0

# file | stderr
LOG_CHANNEL=file
# line | json
LOG_FORMAT=line
LOG_LEVEL=debug
LOG_MAX_FILES=14

# log writes mail to storage/logs/mail.log (local/testing only).
# smtp delivers through a real submission server (required in production).
MAIL_TRANSPORT=log
MAIL_FROM_ADDRESS=no-reply@albabook.co.ke
MAIL_FROM_NAME=AlbaBook
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=

# Platform-owned fallback messaging accounts (D-014 hybrid). When a tenant
# has no provider account of their own, messages send through these with the
# shared sender identity. Leave SMS_PROVIDER empty to disable the fallback.
SMS_PROVIDER=
SMS_USERNAME=
SMS_API_KEY=
SMS_SENDER_ID=AlbaBook
# The platform-paid account only messages these E.164 prefixes (anti SMS
# pumping). Comma-separated; tenants' own provider accounts are unrestricted.
SMS_ALLOWED_PREFIXES=+254
WHATSAPP_ALLOWED_PREFIXES=+254

WHATSAPP_PROVIDER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_SENDER_ID=

ENCRYPTION_KEY=

# Tenant custom booking domains. Leave false until nginx routes unknown
# hosts to PHP and per-domain TLS certificates are issued (docs/deployment.md).
CUSTOM_DOMAINS_ENABLED=false
